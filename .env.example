KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret

# Optional. Add this to calculate holdings/profit from your actual KIS account.
# Either use KIS_ACCOUNT_NO=12345678-01, or split into KIS_CANO / KIS_ACNT_PRDT_CD.
KIS_ACCOUNT_NO=
# KIS_CANO=12345678
# KIS_ACNT_PRDT_CD=01

# Optional. Defaults to the live KIS host.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional. Leave blank unless KIS asks for it for the endpoint you use.
KIS_CUSTTYPE=P

# Optional. Use VTTC8434R or KIS_VIRTUAL=1 for mock accounts.
# KIS_BALANCE_TR_ID=TTTC8434R
# KIS_VIRTUAL=0

# Optional local server port.
PORT=5177
