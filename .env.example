KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret

# Optional. Add this to calculate holdings/profit from your actual KIS account.
# Either use KIS_ACCOUNT_NO=12345678-01, or split into KIS_CANO / KIS_ACNT_PRDT_CD.
KIS_ACCOUNT_NO=
# KIS_CANO=12345678
# KIS_ACNT_PRDT_CD=01

# Optional. Defaults to the live KIS host.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Optional. Leave blank unless KIS asks for it for the endpoint you use.
KIS_CUSTTYPE=P

# Optional. Use VTTC8434R or KIS_VIRTUAL=1 for mock accounts.
# KIS_BALANCE_TR_ID=TTTC8434R
# KIS_VIRTUAL=0

# Optional local server port.
PORT=5177

# Cloud runtime: serve persisted last-known-good data and refresh in background.
DASHBOARD_RUNTIME_MODE=
HOST=0.0.0.0
DASHBOARD_DATA_DIR=
DASHBOARD_CACHE_DIR=
# Optional override for local dotenv loading. systemd uses EnvironmentFile instead.
DASHBOARD_ENV_FILE=
CLOUD_INTRADAY_INTERVAL_MINUTES=10
CLOUD_EOD_HOUR=15
CLOUD_EOD_MINUTE=50

# Optional GPT-5.6 Luna independent review layer.
# Keep the real key only in .env or /etc/portfolio-dashboard.env; never commit it.
OPENAI_API_KEY=
AI_REVIEW_ENABLED=1
AI_REVIEW_MODEL=gpt-5.6-luna
AI_REVIEW_REASONING_EFFORT=low
AI_REVIEW_MAX_CANDIDATES=5
AI_REVIEW_MAX_DAILY_BATCHES=3
AI_REVIEW_TIMEOUT_MS=60000
